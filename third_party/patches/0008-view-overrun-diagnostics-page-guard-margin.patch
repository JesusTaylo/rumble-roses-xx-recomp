+
+void ReportViewOverrun(const char* pool, const char* kind, uint64_t alloc_offset,
+                       uint64_t alloc_size, uint64_t view_size, uint64_t excess_bytes,
+                       bool beyond_page, uint32_t primitive_type, uint32_t index_bits,
+                       bool primitive_restart) {
+  g_overrun_total.fetch_add(1, std::memory_order_relaxed);
+  std::string key = std::string(pool) + "/" + kind + " prim=" + std::to_string(primitive_type) +
+                    " idx=" + std::to_string(index_bits) + "b restart=" +
+                    (primitive_restart ? "1" : "0") + (beyond_page ? " FUERA-DE-PAGINA" : " en-pagina");
+  bool log_now;
+  OverrunStats snapshot;
+  {
+    std::lock_guard<std::mutex> lock(g_overrun_mutex);
+    OverrunStats& s = g_overruns[key];
+    ++s.count;
+    s.max_excess = std::max(s.max_excess, excess_bytes);
+    log_now = (s.count & (s.count - 1)) == 0;  // 1, 2, 4, 8...
+    snapshot = s;
+  }
+  if (log_now) {
+    REXLOG_WARN(
+        "VIEW OOB [{}] alloc(offset={} size={}) view={} bytes excess={} bytes (max {}) veces={}",
+        key, alloc_offset, alloc_size, view_size, excess_bytes, snapshot.max_excess,
+        snapshot.count);
+  }
+}
+
+uint64_t GetViewOverrunTotal() {
