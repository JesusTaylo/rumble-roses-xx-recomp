+void NameAndLog(ID3D12Object* object, const char* name, bool log_always) {
+  if (!object || !name) {
+    return;
+  }
+  static std::atomic<uint32_t> counter{0};
+  std::string full = std::string(name) + "#" + std::to_string(counter.fetch_add(1));
+  object->SetName(std::wstring(full.begin(), full.end()).c_str());
+  Microsoft::WRL::ComPtr<ID3D12Resource> resource;
+  if (SUCCEEDED(object->QueryInterface(IID_PPV_ARGS(&resource)))) {
+    D3D12_RESOURCE_DESC desc = resource->GetDesc();
+    if (desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) {
+      if (desc.Width >= (256u << 10) || log_always) {
+        REXLOG_INFO("GPU resource {}: VA=0x{:016X} size={} bytes", full,
+                    uint64_t(resource->GetGPUVirtualAddress()) & 0x0000FFFFFFFFFFFFull, uint64_t(desc.Width));
+      }
+    } else if (log_always) {
+      REXLOG_INFO("GPU resource {}: texture {}x{}x{} fmt={}", full, uint64_t(desc.Width),
+                  desc.Height, desc.DepthOrArraySize, int(desc.Format));
+    }
+  } else {
+    Microsoft::WRL::ComPtr<ID3D12Heap> heap;
+    if (SUCCEEDED(object->QueryInterface(IID_PPV_ARGS(&heap)))) {
+      REXLOG_INFO("GPU heap {}: size={} bytes", full, uint64_t(heap->GetDesc().SizeInBytes));
+    }
+  }
+}
