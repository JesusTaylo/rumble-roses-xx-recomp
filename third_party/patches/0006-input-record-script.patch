 namespace rex::input {
 
 namespace {
 
+struct ButtonName {
+  const char* name;
+  uint16_t mask;
+};
+constexpr ButtonName kButtons[] = {
+    {"DPAD_UP", 0x0001}, {"DPAD_DOWN", 0x0002}, {"DPAD_LEFT", 0x0004}, {"DPAD_RIGHT", 0x0008},
+    {"START", 0x0010},   {"BACK", 0x0020},      {"LS", 0x0040},        {"RS", 0x0080},
