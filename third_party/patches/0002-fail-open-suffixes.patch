+REXCVAR_DEFINE_STRING(fail_open_suffixes, "", "Kernel/IO",
+                      "Comma-separated, case-insensitive path suffixes (e.g. \".wmv,.xmv\") for "
+                      "which NtCreateFile/NtOpenFile fails with OBJECT_NAME_NOT_FOUND. Used by "
+                      "ports to skip optional content such as intro movies.");
+
 namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
 
+// True when `path` ends with one of the comma-separated suffixes in fail_open_suffixes.
+static bool PathHasFailOpenSuffix(const std::string& path) {
+  const std::string& list = REXCVAR_GET(fail_open_suffixes);
+  if (list.empty()) {
+    return false;
+  }
+  auto lower = [](std::string s) {
+    for (auto& c : s) {
+      c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    }
+    return s;
+  };
+  const std::string p = lower(path);
+  size_t pos = 0;
+  while (pos <= list.size()) {
+    size_t end = list.find(',', pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    const std::string suffix = lower(list.substr(pos, end - pos));
+    if (!suffix.empty() && p.size() >= suffix.size() &&
+        p.compare(p.size() - suffix.size(), suffix.size(), suffix) == 0) {
+      return true;
+    }
+    pos = end + 1;
+  }
+  return false;
+}
